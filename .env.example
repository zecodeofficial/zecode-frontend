# ===========================================
# Zecode Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local or any file with actual credentials

# -----------------------------------------
# Directus CMS (Required for admin scripts)
# -----------------------------------------
DIRECTUS_URL="https://zecode-directus.onrender.com"
DIRECTUS_EMAIL="your-email@example.com"
DIRECTUS_PASSWORD="your-password-here"
NEXT_PUBLIC_DIRECTUS_URL="https://zecode-directus.onrender.com"

# -----------------------------------------
# Database (Optional - for Prisma)
# -----------------------------------------
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# -----------------------------------------
# Application Port (Development only)
# -----------------------------------------
PORT=3000

# -----------------------------------------
# Google Maps / Places API (Optional)
# -----------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
GOOGLE_PLACES_API_KEY="your_google_places_api_key"

# -----------------------------------------
# Instagram Integration (Optional)
# -----------------------------------------
IG_USER_ID="your_instagram_user_id"
IG_ACCESS_TOKEN="your_instagram_access_token"

# -----------------------------------------
# Cloudinary (images served from CDN)
# -----------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="ds8llatku"
